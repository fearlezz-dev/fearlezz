{
  "permissions": {
    "allow": [
      "Bash(fearlezz:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(flutter test:*)",
      "Bash(bun test:*)",
      "Bash(bunx biome:*)",
      "Bash(devenv shell:*)",
      "Bash(devenv up:*)",
      "Bash(trash:*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": ["Bash(git push:*)", "Bash(curl:*)"],
    "deny": ["Bash(rm:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "fearlezz setup hook claude after-shell || true",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "fearlezz setup hook claude before-shell || true",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "fearlezz setup hook claude session-start || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "fearlezz setup hook claude stop || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
